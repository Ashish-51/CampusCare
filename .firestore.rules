rules_version = '2';

// =============================================================================
//  CampusCare — Firestore Security Rules
//  Roles: student | faculty | admin
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    //  HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        callerProfile().role == 'admin'
      );
    }

    function isFaculty() {
      return isSignedIn() && (
        request.auth.token.role == 'faculty' ||
        callerProfile().role == 'faculty'
      );
    }

    function isStudent() {
      return isSignedIn() && (
        request.auth.token.role == 'student' ||
        callerProfile().role == 'student'
      );
    }

    function isComplaintOwner() {
      return isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    function isAssignedFaculty() {
      return isSignedIn() && resource.data.assignedFacultyId == request.auth.uid;
    }

    function isValidComplaint() {
      let d = request.resource.data;
      return d.keys().hasAll([
              'studentId', 'title', 'description',
              'category', 'status', 'createdAt'
             ])
          && d.studentId is string
          && d.title is string
          && d.title.size() >= 5
          && d.title.size() <= 200
          && d.description is string
          && d.description.size() >= 10
          && d.status == 'Submitted'
          && d.studentId == request.auth.uid;
    }

    // Student updates: Feedback submission, cancellation, or reopening
    function isStudentPermittedUpdate() {
      let allowed = ['feedback', 'status', 'closedAt', 'updatedAt', 'resolvedAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Faculty updates: Status, notes, resolution image, timestamps
    function isFacultyPermittedUpdate() {
      let allowed = ['status', 'facultyRemarks', 'acceptedAt', 'resolvedAt', 'resolutionImageUrl', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Admin updates: Management & assignment fields
    function isAdminStatusUpdate() {
      let allowed = [
        'status', 'adminRemarks', 'assignedTo', 'assignedFacultyId', 'assignedFacultyName',
        'resolvedAt', 'closedAt', 'updatedAt', 'feedback', 'facultyRemarks', 'rejectionReason', 'priority', 'urgency'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // =========================================================================
    //  USERS COLLECTION  —  /users/{userId}
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && (request.auth.uid == userId || isAdmin());

      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================================
    //  COMPLAINTS COLLECTION  —  /complaints/{complaintId}
    // =========================================================================
    match /complaints/{complaintId} {

      // READ:
      // - Students can read only their own complaints.
      // - Faculty can read only complaints assigned to them.
      // - Admins can read all complaints.
      allow read: if isSignedIn()
                  && (isComplaintOwner() || isAssignedFaculty() || isAdmin());

      // CREATE:
      // Only authenticated students may file new complaints.
      allow create: if isStudent() && isValidComplaint();

      // UPDATE:
      // 1. Admin: full triage & assignment permissions
      // 2. Assigned Faculty: accept, start work, add remarks, mark resolved
      // 3. Complaint Student: submit feedback, cancel submitted, or reopen resolved
      allow update: if (isAdmin() && isAdminStatusUpdate())
                    ||
                    (isAssignedFaculty() && isFacultyPermittedUpdate())
                    ||
                    (isComplaintOwner() && isStudentPermittedUpdate());

      // DELETE:
      // Only admins may delete complaints.
      allow delete: if isAdmin();

      // =======================================================================
      //  TIMELINE SUB-COLLECTION  —  /complaints/{complaintId}/timeline/{eventId}
      // =======================================================================
      match /timeline/{eventId} {
        allow read: if isSignedIn()
                    && (
                      get(/databases/$(database)/documents/complaints/$(complaintId)).data.studentId == request.auth.uid
                      || get(/databases/$(database)/documents/complaints/$(complaintId)).data.assignedFacultyId == request.auth.uid
                      || isAdmin()
                    );

        allow create: if isSignedIn()
                      && (
                        get(/databases/$(database)/documents/complaints/$(complaintId)).data.studentId == request.auth.uid
                        || get(/databases/$(database)/documents/complaints/$(complaintId)).data.assignedFacultyId == request.auth.uid
                        || isAdmin()
                      );

        allow update, delete: if false;
      }
    }

    // =========================================================================
    //  NOTIFICATIONS COLLECTION  —  /notifications/{notificationId}
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
                  && (resource.data.recipientId == request.auth.uid || isAdmin());

      allow create: if isSignedIn();

      allow update: if isSignedIn()
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);

      allow delete: if isAdmin();
    }

    // =========================================================================
    //  CATEGORIES COLLECTION  —  /categories/{categoryId}
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
